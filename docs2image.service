[Unit]
Description=docs2image - PDF/PPTX to PNG converter service
After=network.target

[Service]
Type=simple
User=%USER%
WorkingDirectory=%INSTALL_DIR%
Environment="DOCS2IMAGE_HOST=%API_HOST%"
Environment="DOCS2IMAGE_PORT=%API_PORT%"
Environment="PYTHONPATH=%INSTALL_DIR%/src"
ExecStart=%INSTALL_DIR%/venv/bin/uvicorn src.server:app --host %API_HOST% --port %API_PORT%
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
